{
  "name": "solstice-manor",
  "version": "1.0.0",
  "description": "Solstice Manor: A 2-Player Cooperative First-Person 3D LAN Escape Room",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts --dev",
    "build": "vite build && tsc --noEmit",
    "start": "vite build && tsx src/server/index.ts",
    "serve": "tsx src/server/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^4.21.2",
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
